{
    "key_vaults": [
        {
            "key_vault_name": "kv-data-platform-dev",
            "location": "Switzerland North",
            "resource_group_name": "rg-data-platform-dev",
            "sku_name": "standard",
            "purge_protection_enabled": true,
            "enabled_for_disk_encryption": true,
            "customer_managed_keys": [
                {
                    "name": "storageaccountkey",
                    "key_type": "RSA",
                    "key_size": 2048,
                    "key_opts": [
                        "decrypt",
                        "encrypt",
                        "sign",
                        "unwrapKey",
                        "verify",
                        "wrapKey"
                    ]
                }
            ],
            "network_acls": [
                {
                    "default_action": "Deny",
                    "bypass": "AzureServices",
                    "ip_rules": [
                        {
                            "value": "0.0.0.0/0"
                        }
                    ]
                }
            ],
            "rbac": [
                {
                    "_comment": "keyvault-dev-identity-01",
                    "object_name": "keyvault-dev-identity-01",
                    "type": "user_assigned_identity",
                    "role_definition_name": "Key Vault Secrets User"
                },
                {
                    "_comment": "keyvault-dev-identity-01",
                    "object_name": "keyvault-dev-identity-01",
                    "type": "user_assigned_identity",
                    "role_definition_name": "Key Vault Certificates User"
                },
                {
                    "_comment": "keyvault-dev-identity-01",
                    "object_name": "keyvault-dev-identity-01",
                    "type": "user_assigned_identity",
                    "role_definition_name": "Key Vault Crypto Officer"
                }
            ]
        }
    ]
}